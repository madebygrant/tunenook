{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tunenook",
	"compatibility_date": "2026-10-06",
	// Static assets only: music never leaves the device, so there is no Worker script.
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": false
	}
}
